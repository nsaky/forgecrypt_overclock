# ============================================================
# Insight AI - Environment Configuration Template
# ============================================================
# Copy this file to .env and fill in your own API keys.
# DO NOT commit your actual .env file to version control.
# ============================================================

# --- LLM Provider ---
# Get your Groq API key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# --- Web Search ---
# Get your SerpAPI key from: https://serpapi.com/manage-api-key
SERPAPI_API_KEY=your_serpapi_key_here

# --- Financial Data ---
# Get your FMP key from: https://financialmodelingprep.com/developer/docs/
FMP_API_KEY=your_fmp_api_key_here

# --- Firebase (Firestore Logging) ---
# Option 1 (Recommended): Paste the entire contents of your
# Firebase service account JSON as a single-line JSON string below.
# Get this from: Firebase Console > Project Settings > Service Accounts > Generate new private key
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project-id",...}

# Option 2 (Fallback): Provide a path to the JSON file instead.
# FIREBASE_CREDENTIALS_PATH=./firebase-adminsdk.json
